PORT=3000
HOST=0.0.0.0
APP_PORT=3000
# Dat thanh IP LAN co dinh cua VM de chi lang nghe tren card mang LAN.
# De 0.0.0.0 neu VM chi co mot card mang noi bo.
APP_BIND_IP=0.0.0.0
SESSION_SECRET=thay-bang-chuoi-tao-boi-lenh-openssl-rand-hex-32
# HTTP trong LAN: false. Khi dat sau HTTPS reverse proxy: true.
COOKIE_SECURE=false
TRUST_PROXY=false

# Tai khoan SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
DB_NAME=MomentumDB

# Dat true neu SQL Server cua ban yeu cau ma hoa ket noi.
DB_ENCRYPT=false
# Chi nen dung true trong moi truong local voi chung chi tu ky.
DB_TRUST_CERT=true
